generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InfrastructureHealth {
  id        String   @id @default(cuid())
  component String
  status    String
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("infrastructure_health")
}

enum OrganizationStatus {
  active
  suspended
}

enum TeamStatus {
  active
  suspended
}

enum UserRole {
  system_admin
  admin
  manager
  sales
}

enum UserStatus {
  invited
  active
  suspended
}

model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  slug              String             @unique
  timezone          String             @default("Asia/Tokyo")
  status            OrganizationStatus @default(active)
  settings          Json               @default("{}")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  teams             Team[]
  users             User[]
  sessions          Session[]
  auditLogs         AuditLog[]
  companies         Company[]
  contacts          CompanyContact[]
  phoneNumbers      PhoneNumber[]
  tags              Tag[]
  salesLists        SalesList[]
  optOuts           OptOut[]
  importJobs        ImportJob[]
  appointments      Appointment[]
  appointmentEvents AppointmentEvent[]

  @@map("organizations")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  managerUserId  String?      @map("manager_user_id") @db.Uuid
  status         TeamStatus   @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  manager        User?        @relation("TeamManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  users          User[]       @relation("TeamMembers")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("teams")
}

model User {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  teamId               String?            @map("team_id") @db.Uuid
  name                 String
  email                String
  passwordHash         String             @map("password_hash")
  role                 UserRole
  status               UserStatus         @default(invited)
  lastLoginAt          DateTime?          @map("last_login_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  team                 Team?              @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managedTeams         Team[]             @relation("TeamManager")
  sessions             Session[]
  auditLogs            AuditLog[]
  ownedCompanies       Company[]          @relation("CompanyOwner")
  assignedTags         CompanyTag[]       @relation("TagAssigner")
  createdSalesLists    SalesList[]        @relation("SalesListCreator")
  addedListCompanies   SalesListCompany[] @relation("ListCompanyAdder")
  registeredOptOuts    OptOut[]           @relation("OptOutRegistrar")
  releasedOptOuts      OptOut[]           @relation("OptOutReleaser")
  importJobs           ImportJob[]        @relation("ImportCreator")
  assignedAppointments Appointment[]      @relation("AppointmentAssignee")

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

model Session {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash")
  csrfTokenHash  String       @map("csrf_token_hash")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([organizationId])
  @@map("sessions")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  action         String
  entityType     String        @map("entity_type")
  entityId       String?       @map("entity_id")
  beforeData     Json?         @map("before_data")
  afterData      Json?         @map("after_data")
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")
  occurredAt     DateTime      @default(now()) @map("occurred_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

enum SalesStatus {
  uncontacted
  planned
  contacting
  gatekeeper_reached
  decision_contact_reached
  retry
  material_sent
  qualified
  appointment
  negotiating
  won
  lost
  excluded
  opt_out
  on_hold
}

enum ContactDecisionRole {
  unknown
  contact
  champion
  decision_maker
}

enum VerificationStatus {
  unverified
  ai_extracted
  verified
}

enum PhoneNumberType {
  representative
  department
  store
  direct
  mobile
  fax
  unknown
}

enum RecordStatus {
  active
  archived
}

enum AssignedSource {
  manual
  import
  system
}

enum SalesListType {
  static
  dynamic
}

enum OptOutScope {
  company
  phone
  contact
  channel
}

enum OptOutChannel {
  all
  phone
  email
  form
  sms
}

enum OptOutStatus {
  active
  released
}

enum OptOutReasonCode {
  customer_request
  complaint
  existing_customer
  competitor
  internal_block
  invalid_number
  closed_business
  duplicate
  out_of_scope
  other
}

enum ImportStatus {
  uploaded
  mapping_required
  preview_ready
  queued
  processing
  completed
  completed_with_errors
  failed
  cancelled
}

enum DuplicatePolicy {
  create
  update
  fill_blank
  skip
  review
}

enum ImportRowAction {
  create
  update
  fill_blank
  skip
  review
  error
}

enum ImportRowProcessingStatus {
  pending
  processing
  success
  skipped
  failed
}

model Company {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  corporateNumber  String?            @map("corporate_number")
  name             String
  normalizedName   String             @map("normalized_name")
  nameKana         String?            @map("name_kana")
  tradeName        String?            @map("trade_name")
  websiteUrl       String?            @map("website_url")
  inquiryUrl       String?            @map("inquiry_url")
  industryCode     String?            @map("industry_code")
  industryName     String?            @map("industry_name")
  employeeRange    String?            @map("employee_range")
  annualSalesRange String?            @map("annual_sales_range")
  establishedYear  Int?               @map("established_year")
  postalCode       String?            @map("postal_code")
  prefecture       String?
  city             String?
  address          String?
  businessHours    String?            @map("business_hours")
  closedDays       String?            @map("closed_days")
  salesStatus      SalesStatus        @default(uncontacted) @map("sales_status")
  ownerUserId      String?            @map("owner_user_id") @db.Uuid
  sourceType       String?            @map("source_type")
  sourceUrl        String?            @map("source_url")
  sourceMetadata   Json               @default("{}") @map("source_metadata")
  lastContactedAt  DateTime?          @map("last_contacted_at")
  nextActionAt     DateTime?          @map("next_action_at")
  nextActionType   String?            @map("next_action_type")
  isCustomer       Boolean            @default(false) @map("is_customer")
  isDeleted        Boolean            @default(false) @map("is_deleted")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner            User?              @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  contacts         CompanyContact[]
  phoneNumbers     PhoneNumber[]
  companyTags      CompanyTag[]
  listCompanies    SalesListCompany[]
  optOuts          OptOut[]
  importRows       ImportRow[]
  appointments     Appointment[]

  @@unique([organizationId, corporateNumber])
  @@index([organizationId, isDeleted, updatedAt(sort: Desc)])
  @@index([organizationId, normalizedName])
  @@index([organizationId, salesStatus])
  @@index([organizationId, ownerUserId])
  @@map("companies")
}

model CompanyContact {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  name               String
  nameKana           String?             @map("name_kana")
  department         String?
  position           String?
  email              String?
  decisionRole       ContactDecisionRole @default(unknown) @map("decision_role")
  verificationStatus VerificationStatus  @default(unverified) @map("verification_status")
  sourceType         String?             @map("source_type")
  verifiedAt         DateTime?           @map("verified_at")
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  isDeleted          Boolean             @default(false) @map("is_deleted")
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  phoneNumbers       PhoneNumber[]
  optOuts            OptOut[]
  appointments       Appointment[]

  @@index([organizationId, companyId, isDeleted])
  @@index([organizationId, email])
  @@map("company_contacts")
}

model PhoneNumber {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  companyId        String          @map("company_id") @db.Uuid
  contactId        String?         @map("contact_id") @db.Uuid
  rawNumber        String          @map("raw_number")
  normalizedNumber String          @map("normalized_number")
  e164Number       String?         @map("e164_number")
  type             PhoneNumberType @default(unknown)
  label            String?
  isPrimary        Boolean         @default(false) @map("is_primary")
  isValid          Boolean         @default(true) @map("is_valid")
  isCallable       Boolean         @default(true) @map("is_callable")
  lastCalledAt     DateTime?       @map("last_called_at")
  lastCallResult   String?         @map("last_call_result")
  totalCallCount   Int             @default(0) @map("total_call_count")
  nextCallableAt   DateTime?       @map("next_callable_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  isDeleted        Boolean         @default(false) @map("is_deleted")
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact          CompanyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  optOuts          OptOut[]

  @@index([organizationId, normalizedNumber])
  @@index([organizationId, companyId, isDeleted])
  @@map("phone_numbers")
}

model Tag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  color          String       @default("#64748b")
  description    String?
  status         RecordStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companyTags    CompanyTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model CompanyTag {
  companyId      String         @map("company_id") @db.Uuid
  tagId          String         @map("tag_id") @db.Uuid
  assignedBy     String?        @map("assigned_by") @db.Uuid
  assignedSource AssignedSource @default(manual) @map("assigned_source")
  createdAt      DateTime       @default(now()) @map("created_at")
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag            Tag            @relation(fields: [tagId], references: [id], onDelete: Restrict)
  assigner       User?          @relation("TagAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([companyId, tagId])
  @@map("company_tags")
}

model SalesList {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  name             String
  description      String?
  listType         SalesListType      @default(static) @map("list_type")
  filterConditions Json               @default("{}") @map("filter_conditions")
  status           RecordStatus       @default(active)
  createdBy        String             @map("created_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  isDeleted        Boolean            @default(false) @map("is_deleted")
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator          User               @relation("SalesListCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  companies        SalesListCompany[]

  @@unique([organizationId, name])
  @@index([organizationId, isDeleted])
  @@map("sales_lists")
}

model SalesListCompany {
  salesListId String         @map("sales_list_id") @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  addedBy     String?        @map("added_by") @db.Uuid
  addedSource AssignedSource @default(manual) @map("added_source")
  addedAt     DateTime       @default(now()) @map("added_at")
  removedAt   DateTime?      @map("removed_at")
  salesList   SalesList      @relation(fields: [salesListId], references: [id], onDelete: Cascade)
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  adder       User?          @relation("ListCompanyAdder", fields: [addedBy], references: [id], onDelete: SetNull)

  @@id([salesListId, companyId])
  @@index([companyId])
  @@map("sales_list_companies")
}

model OptOut {
  id                      String           @id @default(uuid()) @db.Uuid
  organizationId          String           @map("organization_id") @db.Uuid
  companyId               String?          @map("company_id") @db.Uuid
  phoneNumberId           String?          @map("phone_number_id") @db.Uuid
  contactId               String?          @map("contact_id") @db.Uuid
  normalizedPhoneSnapshot String?          @map("normalized_phone_snapshot")
  emailSnapshot           String?          @map("email_snapshot")
  scope                   OptOutScope
  channel                 OptOutChannel
  reasonCode              OptOutReasonCode @map("reason_code")
  reasonText              String?          @map("reason_text")
  evidenceText            String?          @map("evidence_text")
  status                  OptOutStatus     @default(active)
  registeredBy            String           @map("registered_by") @db.Uuid
  registeredAt            DateTime         @default(now()) @map("registered_at")
  releasedBy              String?          @map("released_by") @db.Uuid
  releasedAt              DateTime?        @map("released_at")
  releaseReason           String?          @map("release_reason")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                 Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  phoneNumber             PhoneNumber?     @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  contact                 CompanyContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  registrar               User             @relation("OptOutRegistrar", fields: [registeredBy], references: [id], onDelete: Restrict)
  releaser                User?            @relation("OptOutReleaser", fields: [releasedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, status, companyId])
  @@index([organizationId, status, normalizedPhoneSnapshot])
  @@index([organizationId, status, emailSnapshot])
  @@map("opt_outs")
}

model ImportJob {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  importType       String          @default("companies") @map("import_type")
  originalFileName String          @map("original_file_name")
  storageKey       String          @map("storage_key")
  encoding         String
  mapping          Json            @default("{}")
  duplicatePolicy  DuplicatePolicy @default(review) @map("duplicate_policy")
  status           ImportStatus    @default(uploaded)
  totalRows        Int             @default(0) @map("total_rows")
  validRows        Int             @default(0) @map("valid_rows")
  errorRows        Int             @default(0) @map("error_rows")
  importedRows     Int             @default(0) @map("imported_rows")
  skippedRows      Int             @default(0) @map("skipped_rows")
  createdBy        String          @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  startedAt        DateTime?       @map("started_at")
  completedAt      DateTime?       @map("completed_at")
  expiresAt        DateTime        @map("expires_at")
  errorMessage     String?         @map("error_message")
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator          User            @relation("ImportCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  rows             ImportRow[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("import_jobs")
}

model ImportRow {
  id                  String                    @id @default(uuid()) @db.Uuid
  importJobId         String                    @map("import_job_id") @db.Uuid
  rowNumber           Int                       @map("row_number")
  rawData             Json                      @map("raw_data")
  normalizedData      Json                      @map("normalized_data")
  validationErrors    Json                      @default("[]") @map("validation_errors")
  duplicateCandidates Json                      @default("[]") @map("duplicate_candidates")
  action              ImportRowAction           @default(review)
  processingStatus    ImportRowProcessingStatus @default(pending) @map("processing_status")
  attemptCount        Int                       @default(0) @map("attempt_count")
  lastErrorCode       String?                   @map("last_error_code")
  lastErrorMessage    String?                   @map("last_error_message")
  resultCompanyId     String?                   @map("result_company_id") @db.Uuid
  processedAt         DateTime?                 @map("processed_at")
  importJob           ImportJob                 @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  resultCompany       Company?                  @relation(fields: [resultCompanyId], references: [id], onDelete: SetNull)

  @@unique([importJobId, rowNumber])
  @@index([importJobId, processingStatus, rowNumber])
  @@map("import_rows")
}

enum VersionStatus {
  draft
  published
  archived
}

enum ResourceStatus {
  active
  archived
}

enum CampaignStatus {
  draft
  ready
  running
  paused
  completed
  cancelled
  archived
}

enum CampaignTargetStatus {
  pending
  reserved
  queued
  in_progress
  retry_wait
  completed
  excluded
  cancelled
}

enum EligibilityStatus {
  eligible
  excluded
}

enum CallJobStatus {
  queued
  reserved
  dispatching
  in_progress
  completed
  failed
  cancelled
  skipped
}

enum ScenarioNodeType {
  start
  speak
  listen
  branch
  faq_lookup
  qualify
  schedule_request
  transfer_request
  opt_out
  end
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  code           String
  category       String?
  status         ResourceStatus   @default(active)
  ownerUserId    String?          @map("owner_user_id") @db.Uuid
  createdBy      String           @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  archivedAt     DateTime?        @map("archived_at")
  versions       ProductVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("products")
}

model ProductVersion {
  id                         String        @id @default(uuid()) @db.Uuid
  organizationId             String        @map("organization_id") @db.Uuid
  productId                  String        @map("product_id") @db.Uuid
  versionNumber              Int           @map("version_number")
  status                     VersionStatus @default(draft)
  summary                    String        @default("")
  targetCustomer             String        @default("") @map("target_customer")
  customerProblems           Json          @default("[]") @map("customer_problems")
  valuePropositions          Json          @default("[]") @map("value_propositions")
  differentiators            Json          @default("[]")
  pricingSummary             String        @default("") @map("pricing_summary")
  qualificationConditions    Json          @default("[]") @map("qualification_conditions")
  disqualificationConditions Json          @default("[]") @map("disqualification_conditions")
  requiredDisclosures        Json          @default("[]") @map("required_disclosures")
  prohibitedClaims           Json          @default("[]") @map("prohibited_claims")
  appointmentGoal            String        @default("") @map("appointment_goal")
  sourceMetadata             Json          @default("{}") @map("source_metadata")
  publishedBy                String?       @map("published_by") @db.Uuid
  publishedAt                DateTime?     @map("published_at")
  createdBy                  String        @map("created_by") @db.Uuid
  createdAt                  DateTime      @default(now()) @map("created_at")
  product                    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, versionNumber])
  @@index([organizationId, status])
  @@map("product_versions")
}

model AiAgent {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  status         ResourceStatus   @default(active)
  ownerUserId    String?          @map("owner_user_id") @db.Uuid
  createdBy      String           @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  archivedAt     DateTime?        @map("archived_at")
  versions       AiAgentVersion[]

  @@index([organizationId, status])
  @@map("ai_agents")
}

model AiAgentVersion {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  aiAgentId              String        @map("ai_agent_id") @db.Uuid
  versionNumber          Int           @map("version_number")
  status                 VersionStatus @default(draft)
  displayName            String        @map("display_name")
  roleDescription        String        @default("") @map("role_description")
  language               String        @default("ja")
  speakingStyle          String        @default("professional") @map("speaking_style")
  politenessLevel        Int           @default(3) @map("politeness_level")
  speakingSpeed          Float         @default(1) @map("speaking_speed")
  interruptionPolicy     String        @default("listen") @map("interruption_policy")
  silenceTimeoutSeconds  Int           @default(10) @map("silence_timeout_seconds")
  maxTurns               Int           @default(20) @map("max_turns")
  maxCallDurationSeconds Int           @default(600) @map("max_call_duration_seconds")
  openingPolicy          String        @default("") @map("opening_policy")
  identityDisclosure     String        @default("") @map("identity_disclosure")
  aiDisclosure           String        @default("") @map("ai_disclosure")
  recordingDisclosure    String        @default("") @map("recording_disclosure")
  prohibitedTopics       Json          @default("[]") @map("prohibited_topics")
  escalationRules        Json          @default("[]") @map("escalation_rules")
  fallbackMessage        String        @default("") @map("fallback_message")
  closingMessage         String        @default("") @map("closing_message")
  publishedBy            String?       @map("published_by") @db.Uuid
  publishedAt            DateTime?     @map("published_at")
  createdBy              String        @map("created_by") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at")
  aiAgent                AiAgent       @relation(fields: [aiAgentId], references: [id], onDelete: Restrict)

  @@unique([aiAgentId, versionNumber])
  @@index([organizationId, status])
  @@map("ai_agent_versions")
}

model ConversationScenario {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String
  purpose        String            @default("")
  status         ResourceStatus    @default(active)
  createdBy      String            @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  archivedAt     DateTime?         @map("archived_at")
  versions       ScenarioVersion[]

  @@index([organizationId, status])
