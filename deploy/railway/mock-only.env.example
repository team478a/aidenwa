# Copy these names into Railway Variables. Never commit the real values.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
API_INTERNAL_URL=http://api.railway.internal:3001
WEB_ORIGIN=https://REPLACE_WITH_WEB_DOMAIN
RELEASE_COMMIT=REPLACE_WITH_GIT_COMMIT_SHA

# Generate independent random values in Railway; do not reuse them.
SOURCE_NUMBER_FINGERPRINT_KEY=GENERATE_RANDOM_32_OR_MORE_CHARACTERS
MOCK_WEBHOOK_SECRET=GENERATE_RANDOM_32_OR_MORE_CHARACTERS
APPOINTMENT_SLOT_TOKEN_SECRET=GENERATE_RANDOM_32_OR_MORE_CHARACTERS

# Gate A invariant: do not change these values.
VOICE_PROVIDER=mock
PRODUCTION_PROVIDER_ALLOWLIST=mock
PRODUCTION_CALLS_ENABLED=false
REALTIME_AI_ENABLED=false
TWILIO_MEDIA_STREAMS_ENABLED=false
ZOOM_PHONE_INTEGRATION_ENABLED=false
ZOOM_PHONE_OUTBOUND_ENABLED=false
AI_HANDOFF_ENABLED=false
CALENDAR_INTEGRATION_ENABLED=false
AI_APPOINTMENT_BOOKING_ENABLED=false

# Gate A invariant: do not create Twilio/OpenAI/Zoom/calendar credential variables.

